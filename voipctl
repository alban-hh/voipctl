#!/usr/bin/env python3
"""voipctl - manage the outbound-only VoIP server.

Everything under /etc/voip is the source of truth. `voipctl apply` validates
it and regenerates the Asterisk, nftables and fail2ban configuration from it.
Run `voipctl --help` for the command list, or see /root/README.
"""

import argparse
import configparser
import getpass
import grp
import ipaddress
import os
import re
import secrets
import string
import subprocess
import sys
import tempfile
from pathlib import Path

# ---------------------------------------------------------------- locations
ETC = Path("/etc/voip")
WHITELIST = ETC / "whitelist.conf"
TELNYX_RANGES = ETC / "telnyx.conf"
BLOCKED = ETC / "blocked_prefixes.conf"
CUSTOMERS = ETC / "customers"
POOLS = ETC / "cidpools"
SECRETS = ETC / "secrets"
TELNYX_CREDS = SECRETS / "telnyx.conf"

AST_ETC = Path("/etc/asterisk")
OUT_PJSIP_CUST = AST_ETC / "pjsip_customers.conf"
OUT_PJSIP_TELNYX = AST_ETC / "pjsip_telnyx.conf"
OUT_EXT = AST_ETC / "extensions_customers.conf"
OUT_NFT = Path("/etc/nftables.conf")
OUT_F2B = Path("/etc/fail2ban/jail.d/voip.local")
POOL_OUT = Path("/var/lib/asterisk/cidpools")

# ---------------------------------------------------------------- constants
SSH_PORT = 22
SIP_PORT = 5060
RTP_START, RTP_END = 10000, 20000      # must match /etc/asterisk/rtp.conf
WAN_IF = "eth0"
DHCP_SERVER = "172.31.1.1"             # Hetzner gateway, hands out the /32 lease
NFT_TABLE = "voipfw"
MIN_PREFIXLEN = 16                     # refuse whitelist entries wider than this
DEFAULT_MAX_CALLS = 2
DEFAULT_MAX_SECONDS = 3600
DIAL_TIMEOUT = 60

RE_CUSTOMER = re.compile(r"^[a-z][a-z0-9]{1,19}$")
RE_EXT = re.compile(r"^[0-9]{2,8}$")
RE_POOL = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
RE_E164 = re.compile(r"^\+[1-9][0-9]{6,14}$")
RE_PREFIX = re.compile(r"^[1-9][0-9]{0,14}$")

GENERATED = "GENERATED by voipctl - do not edit. Edit /etc/voip and run: voipctl apply"


class Fail(Exception):
    """A user-facing error: printed without a traceback."""


def warn(msg):
    print(f"warning: {msg}", file=sys.stderr)


def run(cmd, check=True, capture=True, input_text=None):
    res = subprocess.run(cmd, text=True, input=input_text,
                         stdout=subprocess.PIPE if capture else None,
                         stderr=subprocess.STDOUT if capture else None)
    if check and res.returncode != 0:
        raise Fail(f"command failed: {' '.join(cmd)}\n{(res.stdout or '').strip()}")
    return res


def asterisk_gid():
    try:
        return grp.getgrnam("asterisk").gr_gid
    except KeyError:
        return 0


def write_file(path, content, mode=0o640, gid=0):
    """Atomically write `content`; return True if the file changed."""
    path = Path(path)
    old = path.read_text() if path.exists() else None
    changed = old != content
    if changed:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.")
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.chown(tmp, 0, gid)
        os.replace(tmp, path)
    else:
        os.chmod(path, mode)
        os.chown(path, 0, gid)
    return changed


# ---------------------------------------------------------------- whitelist
def parse_net(text):
    try:
        net = ipaddress.ip_network(text, strict=False)
    except ValueError:
        raise Fail(f"'{text}' is not a valid IP address or CIDR range")
    if net.version != 4:
        raise Fail(f"'{text}': IPv6 is disabled on this server, IPv4 only")
    if net.prefixlen < MIN_PREFIXLEN:
        raise Fail(f"'{text}': range too wide (/{net.prefixlen}); "
                   f"the smallest allowed prefix is /{MIN_PREFIXLEN}")
    if net.is_loopback or net.is_multicast or net.is_unspecified:
        raise Fail(f"'{text}': not a usable source address")
    return net


def parse_role(text):
    if text == "admin":
        return "admin", None
    if text.startswith("customer:"):
        name = text.split(":", 1)[1]
        if not RE_CUSTOMER.match(name):
            raise Fail(f"'{text}': bad customer name")
        return "customer", name
    raise Fail(f"'{text}': role must be 'admin' or 'customer:<name>'")


def load_whitelist():
    """Return a list of dicts: net, role, customer, label."""
    entries = []
    if not WHITELIST.exists():
        return entries
    for num, raw in enumerate(WHITELIST.read_text().splitlines(), 1):
        body, _, label = raw.partition("#")
        fields = body.split()
        if not fields:
            continue
        if len(fields) != 2:
            raise Fail(f"{WHITELIST}:{num}: expected '<ip-or-cidr> <role>  # label', got: {raw.strip()}")
        try:
            net = parse_net(fields[0])
            role, customer = parse_role(fields[1])
        except Fail as exc:
            raise Fail(f"{WHITELIST}:{num}: {exc}")
        entries.append({"net": net, "role": role, "customer": customer, "label": label.strip()})
    return entries


def nets_for(entries, role, customer=None):
    nets = [e["net"] for e in entries
            if e["role"] == role and (customer is None or e["customer"] == customer)]
    return list(ipaddress.collapse_addresses(nets))


def fmt_net(net):
    return str(net.network_address) if net.prefixlen == 32 else str(net)


# ---------------------------------------------------------------- telnyx
def load_telnyx_ranges():
    data = {"host": "sip.telnyx.com", "port": 5060, "signaling": [], "media": []}
    if not TELNYX_RANGES.exists():
        raise Fail(f"{TELNYX_RANGES} is missing")
    for num, raw in enumerate(TELNYX_RANGES.read_text().splitlines(), 1):
        fields = raw.partition("#")[0].split()
        if not fields:
            continue
        if len(fields) != 2 or fields[0] not in ("host", "signaling", "media"):
            raise Fail(f"{TELNYX_RANGES}:{num}: expected 'host|signaling|media <value>'")
        if fields[0] == "host":
            host, _, port = fields[1].partition(":")
            if not re.match(r"^[A-Za-z0-9.-]+$", host):
                raise Fail(f"{TELNYX_RANGES}:{num}: bad host")
            data["host"], data["port"] = host, int(port or 5060)
        else:
            try:
                data[fields[0]].append(parse_net(fields[1]))
            except Fail as exc:
                raise Fail(f"{TELNYX_RANGES}:{num}: {exc}")
    for key in ("signaling", "media"):
        data[key] = list(ipaddress.collapse_addresses(data[key]))
        if not data[key]:
            raise Fail(f"{TELNYX_RANGES}: no '{key}' entries")
    return data


def load_telnyx_creds():
    if not TELNYX_CREDS.exists():
        return None
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(TELNYX_CREDS)
    user = cp.get("telnyx", "username", fallback="").strip()
    password = cp.get("telnyx", "password", fallback="").strip()
    if not user or not password:
        return None
    return user, password


def ast_escape(value):
    """Escape a value for an Asterisk .conf file (';' starts a comment)."""
    if "\n" in value or "\r" in value:
        raise Fail("credentials must not contain line breaks")
    return value.replace(";", "\\;")


# ---------------------------------------------------------------- customers
def customer_path(name):
    return CUSTOMERS / f"{name}.conf"


def load_customer(name):
    path = customer_path(name)
    if not path.exists():
        raise Fail(f"no such customer: {name}")
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(path)
    if not cp.has_section("customer"):
        raise Fail(f"{path}: missing [customer] section")
    try:
        max_calls = cp.getint("customer", "max_calls", fallback=DEFAULT_MAX_CALLS)
        max_seconds = cp.getint("customer", "max_call_seconds", fallback=DEFAULT_MAX_SECONDS)
    except ValueError:
        raise Fail(f"{path}: max_calls and max_call_seconds must be whole numbers")
    if not 1 <= max_calls <= 1000:
        raise Fail(f"{path}: max_calls must be between 1 and 1000")
    if not 30 <= max_seconds <= 86400:
        raise Fail(f"{path}: max_call_seconds must be between 30 and 86400")
    default_country = cp.get("customer", "default_country", fallback="").strip().lstrip("+")
    if default_country and not re.match(r"^[1-9][0-9]{0,3}$", default_country):
        raise Fail(f"{path}: default_country must be a country code such as 355")
    prefixes = cp.get("customer", "allowed_prefixes", fallback="").replace(",", " ").split()
    prefixes = [p.lstrip("+") for p in prefixes]
    for p in prefixes:
        if not RE_PREFIX.match(p):
            raise Fail(f"{path}: allowed prefix '{p}' must be digits of an international number, e.g. 1 or 44 or 3556")
    exts = {}
    for section in cp.sections():
        if section == "customer":
            continue
        m = re.match(r"^ext\s+(\S+)$", section)
        if not m or not RE_EXT.match(m.group(1)):
            raise Fail(f"{path}: bad section [{section}], expected [ext <digits>]")
        ext = m.group(1)
        password = cp.get(section, "password", fallback="")
        cid = cp.get(section, "cid", fallback="").strip()
        if len(password) < 16:
            raise Fail(f"{path}: [{section}] password is missing or shorter than 16 characters")
        cid2 = cp.get(section, "cid2", fallback="").strip()
        for key, value in (("cid", cid), ("cid2", cid2)):
            if key == "cid2" and not value:
                continue
            if value.startswith("pool:"):
                if not RE_POOL.match(value[5:]):
                    raise Fail(f"{path}: [{section}] bad pool name in {key}")
            elif not RE_E164.match(value):
                raise Fail(f"{path}: [{section}] {key} must be +<number> or pool:<name>")
        exts[ext] = {"password": password, "cid": cid, "cid2": cid2}
    return {"name": name, "max_calls": max_calls, "max_seconds": max_seconds,
            "prefixes": sorted(set(prefixes)), "default_country": default_country, "exts": exts}


def list_customers():
    if not CUSTOMERS.exists():
        return []
    names = sorted(p.stem for p in CUSTOMERS.glob("*.conf"))
    for n in names:
        if not RE_CUSTOMER.match(n):
            raise Fail(f"{CUSTOMERS}/{n}.conf: bad customer file name")
    return names


def save_customer(cust):
    lines = [f"# Customer '{cust['name']}'. Edit, then run: voipctl apply",
             "[customer]",
             f"max_calls = {cust['max_calls']}",
             f"max_call_seconds = {cust['max_seconds']}",
             f"allowed_prefixes = {' '.join(cust['prefixes'])}"]
    if cust.get("default_country"):
        lines.append(f"default_country = {cust['default_country']}")
    lines.append("")
    for ext in sorted(cust["exts"]):
        e = cust["exts"][ext]
        lines += [f"[ext {ext}]", f"password = {e['password']}", f"cid = {e['cid']}"]
        if e.get("cid2"):
            lines.append(f"cid2 = {e['cid2']}")
        lines.append("")
    write_file(customer_path(cust["name"]), "\n".join(lines), mode=0o600)


def new_password(length=32):
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


# ---------------------------------------------------------------- CID pools
def load_pool(name):
    """Return the valid numbers in a pool file (comments/blank lines ignored)."""
    path = POOLS / f"{name}.txt"
    if not path.exists():
        raise Fail(f"no such caller ID pool: {name} (expected {path})")
    numbers, bad = [], []
    for raw in path.read_text().splitlines():
        value = raw.partition("#")[0].strip().replace(" ", "")
        if not value:
            continue
        (numbers if RE_E164.match(value) else bad).append(value)
    return numbers, bad


def list_pools():
    if not POOLS.exists():
        return []
    return sorted(p.stem for p in POOLS.glob("*.txt") if RE_POOL.match(p.stem))


def sync_pools(quiet=False):
    """Compile /etc/voip/cidpools/*.txt into the clean lists Asterisk reads."""
    gid = asterisk_gid()
    POOL_OUT.mkdir(parents=True, exist_ok=True)
    os.chmod(POOL_OUT, 0o750)
    os.chown(POOL_OUT, 0, gid)
    wanted = set()
    for name in list_pools():
        numbers, bad = load_pool(name)
        for b in bad:
            warn(f"pool {name}: ignoring invalid number '{b}' (use +<countrycode><number>)")
        if not numbers:
            warn(f"pool {name}: no valid numbers - calls using it will be rejected")
        target = POOL_OUT / f"{name}.list"
        wanted.add(target.name)
        write_file(target, "".join(n + "\n" for n in numbers), mode=0o640, gid=gid)
        if not quiet:
            print(f"pool {name}: {len(numbers)} number(s)")
    for stale in POOL_OUT.glob("*.list"):
        if stale.name not in wanted:
            stale.unlink()


# ---------------------------------------------------------------- blocked prefixes
def load_blocked():
    prefixes = []
    if BLOCKED.exists():
        for num, raw in enumerate(BLOCKED.read_text().splitlines(), 1):
            value = raw.partition("#")[0].strip().lstrip("+")
            if not value:
                continue
            if not RE_PREFIX.match(value):
                raise Fail(f"{BLOCKED}:{num}: '{value}' is not a digit prefix")
            prefixes.append(value)
    return sorted(set(prefixes))


# ---------------------------------------------------------------- rendering
def render_pjsip_telnyx(tel, creds):
    out = [f"; {GENERATED}", ""]
    if not creds:
        out += ["; Telnyx credentials are not set yet. Run: voipctl telnyx set-creds", ""]
        return "\n".join(out)
    user, password = creds
    out += [
        "[telnyx]",
        "type=endpoint",
        "transport=transport-udp",
        "context=from-telnyx",
        "disallow=all",
        "allow=ulaw,alaw",
        "outbound_auth=telnyx-auth",
        "aors=telnyx",
        f"from_domain={tel['host']}",
        "direct_media=no",
        "dtmf_mode=rfc4733",
        "allow_transfer=no",
        "allow_subscribe=no",
        "trust_id_inbound=no",
        "send_pai=no",
        "send_rpid=no",
        "",
        "[telnyx-auth]",
        "type=auth",
        "auth_type=userpass",
        f"username={ast_escape(user)}",
        f"password={ast_escape(password)}",
        "",
        "[telnyx]",
        "type=aor",
        f"contact=sip:{tel['host']}:{tel['port']}",
        "qualify_frequency=60",
        "",
        "; Requests arriving from Telnyx signalling addresses map to the trunk",
        "; endpoint, whose context only hangs up (this server is outbound-only).",
        "[telnyx-identify]",
        "type=identify",
        "endpoint=telnyx",
    ]
    out += [f"match={fmt_net(n)}" for n in tel["signaling"]]
    out.append("")
    return "\n".join(out)


def render_pjsip_customers(customers, whitelist):
    out = [f"; {GENERATED}", ""]
    for cust in customers:
        nets = nets_for(whitelist, "customer", cust["name"])
        out.append(f";;;;;;;; customer {cust['name']}: {len(cust['exts'])} extension(s), "
                   f"source lock: {len(nets) or 'none (Hetzner firewall only)'}")
        for ext in sorted(cust["exts"]):
            e = cust["exts"][ext]
            name = ext
            mode, value = ("pool", e["cid"][5:]) if e["cid"].startswith("pool:") else ("fixed", e["cid"])
            out += [
                f"[{name}]",
                "type=endpoint",
                "transport=transport-udp",
                f"context=cust-{cust['name']}",
                f"accountcode={cust['name']}",
                "disallow=all",
                "allow=ulaw,alaw",
                f"auth={name}",
                f"aors={name}",
                "identify_by=username,auth_username",
                "direct_media=no",
                "rtp_symmetric=yes",
                "force_rport=yes",
                "rewrite_contact=yes",
                "dtmf_mode=rfc4733",
                "allow_transfer=no",
                "allow_subscribe=no",
                "trust_id_inbound=no",
                "send_pai=no",
                "send_rpid=no",
                "ice_support=no",
                f"set_var=VOIP_EXT={ext}",
                f"set_var=VOIP_CID_MODE={mode}",
                f"set_var=VOIP_CID_VALUE={value}",
            ]
            if e.get("cid2"):
                m2, v2 = ("pool", e["cid2"][5:]) if e["cid2"].startswith("pool:") else ("fixed", e["cid2"])
                out += [f"set_var=VOIP_CID2_MODE={m2}", f"set_var=VOIP_CID2_VALUE={v2}"]
            if nets:
                out += ["; optional source lock: only these addresses may use the endpoint",
                        "deny=0.0.0.0/0.0.0.0"]
                out += [f"permit={n.network_address}/{n.netmask}" for n in nets]
            out += [
                "",
                f"[{name}]",
                "type=auth",
                "auth_type=userpass",
                f"username={name}",
                f"password={e['password']}",
                "",
                f"[{name}]",
                "type=aor",
                "max_contacts=1",
                "remove_existing=yes",
                "minimum_expiration=60",
                "default_expiration=300",
                "maximum_expiration=3600",
                "qualify_frequency=0",
                "",
            ]
    return "\n".join(out) + "\n"


def render_extensions(customers, blocked):
    out = [f"; {GENERATED}", ""]
    out += ["; Prefixes nobody may call, whatever their allowed list says.", "[voip-blocked]"]
    out += [f"exten => _+{p}.,1,NoOp(blocked prefix)" for p in blocked]
    out.append("")
    for cust in customers:
        n = cust["name"]
        out += [f"; Destinations customer '{n}' may call.", f"[dest-{n}]"]
        out += [f"exten => _+{p}.,1,NoOp(allowed prefix)" for p in cust["prefixes"]]
        out += [
            "",
            f"[cust-{n}]",
            f"exten => _[+0-9].,1,NoOp({n}/${{VOIP_EXT}} from ${{CHANNEL(pjsip,remote_addr)}} dialed ${{EXTEN}})",
            " same => n,Set(CDR(customer_ext)=${VOIP_EXT})",
            " same => n,Set(CDR(src_ip)=${CHANNEL(pjsip,remote_addr)})",
            "; --- normalise to +E.164; anything that is not purely + and digits is refused",
            " same => n,Set(RAW=${FILTER(+0-9,${EXTEN})})",
            ' same => n,GotoIf($["${RAW}" != "${EXTEN}"]?invalid)',
            " same => n,Set(NUM=${RAW})",
            ' same => n,ExecIf($["${RAW:0:1}" = "+"]?Set(NUM=${RAW:1}))',
            ' same => n,ExecIf($["${RAW:0:2}" = "00"]?Set(NUM=${RAW:2}))',
        ] + ([
            "; national format: one leading 0 means the customer's default country",
