GENERATED = "GENERATED by voipctl - do not edit. Edit /etc/voip and run: voipctl apply"


class Fail(Exception):
    """A user-facing error: printed without a traceback."""


def warn(msg):
    print(f"warning: {msg}", file=sys.stderr)


def run(cmd, check=True, capture=True, input_text=None):
    res = subprocess.run(cmd, text=True, input=input_text,
                         stdout=subprocess.PIPE if capture else None,
                         stderr=subprocess.STDOUT if capture else None)
    if check and res.returncode != 0:
        raise Fail(f"command failed: {' '.join(cmd)}\n{(res.stdout or '').strip()}")
    return res


def asterisk_gid():
    try:
        return grp.getgrnam("asterisk").gr_gid
    except KeyError:
        return 0


def write_file(path, content, mode=0o640, gid=0):
    """Atomically write `content`; return True if the file changed."""
    path = Path(path)
    old = path.read_text() if path.exists() else None
    changed = old != content
    if changed:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.")
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.chown(tmp, 0, gid)
        os.replace(tmp, path)
    else:
        os.chmod(path, mode)
        os.chown(path, 0, gid)
    return changed


# ---------------------------------------------------------------- whitelist
def parse_net(text):
    try:
        net = ipaddress.ip_network(text, strict=False)
    except ValueError:
        raise Fail(f"'{text}' is not a valid IP address or CIDR range")
    if net.version != 4:
        raise Fail(f"'{text}': IPv6 is disabled on this server, IPv4 only")
    if net.prefixlen < MIN_PREFIXLEN:
        raise Fail(f"'{text}': range too wide (/{net.prefixlen}); "
                   f"the smallest allowed prefix is /{MIN_PREFIXLEN}")
    if net.is_loopback or net.is_multicast or net.is_unspecified:
        raise Fail(f"'{text}': not a usable source address")
    return net


def parse_role(text):
    if text == "admin":
        return "admin", None
    if text.startswith("customer:"):
        name = text.split(":", 1)[1]
        if not RE_CUSTOMER.match(name):
            raise Fail(f"'{text}': bad customer name")
        return "customer", name
    raise Fail(f"'{text}': role must be 'admin' or 'customer:<name>'")


def load_whitelist():
    """Return a list of dicts: net, role, customer, label."""
    entries = []
    if not WHITELIST.exists():
        return entries
    for num, raw in enumerate(WHITELIST.read_text().splitlines(), 1):
        body, _, label = raw.partition("#")
        fields = body.split()
        if not fields:
            continue
        if len(fields) != 2:
            raise Fail(f"{WHITELIST}:{num}: expected '<ip-or-cidr> <role>  # label', got: {raw.strip()}")
        try:
            net = parse_net(fields[0])
            role, customer = parse_role(fields[1])
        except Fail as exc:
            raise Fail(f"{WHITELIST}:{num}: {exc}")
        entries.append({"net": net, "role": role, "customer": customer, "label": label.strip()})
    return entries


def nets_for(entries, role, customer=None):
    nets = [e["net"] for e in entries
            if e["role"] == role and (customer is None or e["customer"] == customer)]
    return list(ipaddress.collapse_addresses(nets))


def fmt_net(net):
    return str(net.network_address) if net.prefixlen == 32 else str(net)


# ---------------------------------------------------------------- telnyx
def load_telnyx_ranges():
    data = {"host": "sip.telnyx.com", "port": 5060, "signaling": [], "media": []}
    if not TELNYX_RANGES.exists():
        raise Fail(f"{TELNYX_RANGES} is missing")
    for num, raw in enumerate(TELNYX_RANGES.read_text().splitlines(), 1):
        fields = raw.partition("#")[0].split()
        if not fields:
            continue
        if len(fields) != 2 or fields[0] not in ("host", "signaling", "media"):
            raise Fail(f"{TELNYX_RANGES}:{num}: expected 'host|signaling|media <value>'")
        if fields[0] == "host":
            host, _, port = fields[1].partition(":")
            if not re.match(r"^[A-Za-z0-9.-]+$", host):
                raise Fail(f"{TELNYX_RANGES}:{num}: bad host")
            data["host"], data["port"] = host, int(port or 5060)
        else:
            try:
                data[fields[0]].append(parse_net(fields[1]))
            except Fail as exc:
                raise Fail(f"{TELNYX_RANGES}:{num}: {exc}")
    for key in ("signaling", "media"):
        data[key] = list(ipaddress.collapse_addresses(data[key]))
        if not data[key]:
            raise Fail(f"{TELNYX_RANGES}: no '{key}' entries")
    return data


