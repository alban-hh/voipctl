RE_CUSTOMER = re.compile(r"^[a-z][a-z0-9]{1,19}$")
RE_EXT = re.compile(r"^[0-9]{2,8}$")
RE_POOL = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
