#!/usr/bin/env python3
"""voipctl - manage the outbound-only VoIP server.

Everything under /etc/voip is the source of truth. `voipctl apply` validates
it and regenerates the Asterisk, nftables and fail2ban configuration from it.
Run `voipctl --help` for the command list, or see /root/README.
"""

import argparse
import configparser
import getpass
import grp
import ipaddress
import os
import re
import secrets
import string
import subprocess
import sys
import tempfile
from pathlib import Path

# ---------------------------------------------------------------- locations
ETC = Path("/etc/voip")
WHITELIST = ETC / "whitelist.conf"
TELNYX_RANGES = ETC / "telnyx.conf"
BLOCKED = ETC / "blocked_prefixes.conf"
CUSTOMERS = ETC / "customers"
POOLS = ETC / "cidpools"
SECRETS = ETC / "secrets"
TELNYX_CREDS = SECRETS / "telnyx.conf"

AST_ETC = Path("/etc/asterisk")
OUT_PJSIP_CUST = AST_ETC / "pjsip_customers.conf"
OUT_PJSIP_TELNYX = AST_ETC / "pjsip_telnyx.conf"
OUT_EXT = AST_ETC / "extensions_customers.conf"
OUT_NFT = Path("/etc/nftables.conf")
OUT_F2B = Path("/etc/fail2ban/jail.d/voip.local")
POOL_OUT = Path("/var/lib/asterisk/cidpools")

# ---------------------------------------------------------------- constants
SSH_PORT = 22
SIP_PORT = 5060
RTP_START, RTP_END = 10000, 20000      # must match /etc/asterisk/rtp.conf
WAN_IF = "eth0"
DHCP_SERVER = "172.31.1.1"             # Hetzner gateway, hands out the /32 lease
NFT_TABLE = "voipfw"
MIN_PREFIXLEN = 16                     # refuse whitelist entries wider than this
DEFAULT_MAX_CALLS = 2
DEFAULT_MAX_SECONDS = 3600
DIAL_TIMEOUT = 60

RE_CUSTOMER = re.compile(r"^[a-z][a-z0-9]{1,19}$")
RE_EXT = re.compile(r"^[0-9]{2,8}$")
RE_POOL = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
RE_E164 = re.compile(r"^\+[1-9][0-9]{6,14}$")
RE_PREFIX = re.compile(r"^[1-9][0-9]{0,14}$")

GENERATED = "GENERATED by voipctl - do not edit. Edit /etc/voip and run: voipctl apply"


class Fail(Exception):
    """A user-facing error: printed without a traceback."""


def warn(msg):
    print(f"warning: {msg}", file=sys.stderr)


def run(cmd, check=True, capture=True, input_text=None):
    res = subprocess.run(cmd, text=True, input=input_text,
                         stdout=subprocess.PIPE if capture else None,
                         stderr=subprocess.STDOUT if capture else None)
    if check and res.returncode != 0:
        raise Fail(f"command failed: {' '.join(cmd)}\n{(res.stdout or '').strip()}")
    return res


def asterisk_gid():
    try:
        return grp.getgrnam("asterisk").gr_gid
    except KeyError:
        return 0


def write_file(path, content, mode=0o640, gid=0):
    """Atomically write `content`; return True if the file changed."""
    path = Path(path)
    old = path.read_text() if path.exists() else None
    changed = old != content
    if changed:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.")
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.chown(tmp, 0, gid)
        os.replace(tmp, path)
    else:
        os.chmod(path, mode)
        os.chown(path, 0, gid)
    return changed


# ---------------------------------------------------------------- whitelist
def parse_net(text):
    try:
        net = ipaddress.ip_network(text, strict=False)
    except ValueError:
        raise Fail(f"'{text}' is not a valid IP address or CIDR range")
    if net.version != 4:
        raise Fail(f"'{text}': IPv6 is disabled on this server, IPv4 only")
    if net.prefixlen < MIN_PREFIXLEN:
        raise Fail(f"'{text}': range too wide (/{net.prefixlen}); "
                   f"the smallest allowed prefix is /{MIN_PREFIXLEN}")
    if net.is_loopback or net.is_multicast or net.is_unspecified:
        raise Fail(f"'{text}': not a usable source address")
    return net


def parse_role(text):
    if text == "admin":
        return "admin", None
    if text.startswith("customer:"):
        name = text.split(":", 1)[1]
        if not RE_CUSTOMER.match(name):
            raise Fail(f"'{text}': bad customer name")
        return "customer", name
    raise Fail(f"'{text}': role must be 'admin' or 'customer:<name>'")


def load_whitelist():
    """Return a list of dicts: net, role, customer, label."""
    entries = []
    if not WHITELIST.exists():
        return entries
    for num, raw in enumerate(WHITELIST.read_text().splitlines(), 1):
        body, _, label = raw.partition("#")
        fields = body.split()
        if not fields:
            continue
        if len(fields) != 2:
            raise Fail(f"{WHITELIST}:{num}: expected '<ip-or-cidr> <role>  # label', got: {raw.strip()}")
        try:
            net = parse_net(fields[0])
            role, customer = parse_role(fields[1])
        except Fail as exc:
            raise Fail(f"{WHITELIST}:{num}: {exc}")
        entries.append({"net": net, "role": role, "customer": customer, "label": label.strip()})
    return entries


def nets_for(entries, role, customer=None):
    nets = [e["net"] for e in entries
            if e["role"] == role and (customer is None or e["customer"] == customer)]
    return list(ipaddress.collapse_addresses(nets))


def fmt_net(net):
    return str(net.network_address) if net.prefixlen == 32 else str(net)


# ---------------------------------------------------------------- telnyx
def load_telnyx_ranges():
    data = {"host": "sip.telnyx.com", "port": 5060, "signaling": [], "media": []}
    if not TELNYX_RANGES.exists():
        raise Fail(f"{TELNYX_RANGES} is missing")
    for num, raw in enumerate(TELNYX_RANGES.read_text().splitlines(), 1):
        fields = raw.partition("#")[0].split()
        if not fields:
            continue
        if len(fields) != 2 or fields[0] not in ("host", "signaling", "media"):
            raise Fail(f"{TELNYX_RANGES}:{num}: expected 'host|signaling|media <value>'")
        if fields[0] == "host":
            host, _, port = fields[1].partition(":")
            if not re.match(r"^[A-Za-z0-9.-]+$", host):
                raise Fail(f"{TELNYX_RANGES}:{num}: bad host")
            data["host"], data["port"] = host, int(port or 5060)
        else:
            try:
                data[fields[0]].append(parse_net(fields[1]))
            except Fail as exc:
                raise Fail(f"{TELNYX_RANGES}:{num}: {exc}")
    for key in ("signaling", "media"):
        data[key] = list(ipaddress.collapse_addresses(data[key]))
        if not data[key]:
            raise Fail(f"{TELNYX_RANGES}: no '{key}' entries")
    return data


def load_telnyx_creds():
    if not TELNYX_CREDS.exists():
        return None
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(TELNYX_CREDS)
    user = cp.get("telnyx", "username", fallback="").strip()
    password = cp.get("telnyx", "password", fallback="").strip()
    if not user or not password:
        return None
    return user, password


def ast_escape(value):
    """Escape a value for an Asterisk .conf file (';' starts a comment)."""
    if "\n" in value or "\r" in value:
        raise Fail("credentials must not contain line breaks")
    return value.replace(";", "\\;")


# ---------------------------------------------------------------- customers
def customer_path(name):
    return CUSTOMERS / f"{name}.conf"


def load_customer(name):
    path = customer_path(name)
    if not path.exists():
        raise Fail(f"no such customer: {name}")
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(path)
    if not cp.has_section("customer"):
        raise Fail(f"{path}: missing [customer] section")
    try:
        max_calls = cp.getint("customer", "max_calls", fallback=DEFAULT_MAX_CALLS)
        max_seconds = cp.getint("customer", "max_call_seconds", fallback=DEFAULT_MAX_SECONDS)
    except ValueError:
        raise Fail(f"{path}: max_calls and max_call_seconds must be whole numbers")
    if not 1 <= max_calls <= 1000:
        raise Fail(f"{path}: max_calls must be between 1 and 1000")
    if not 30 <= max_seconds <= 86400:
        raise Fail(f"{path}: max_call_seconds must be between 30 and 86400")
    default_country = cp.get("customer", "default_country", fallback="").strip().lstrip("+")
    if default_country and not re.match(r"^[1-9][0-9]{0,3}$", default_country):
        raise Fail(f"{path}: default_country must be a country code such as 355")
    prefixes = cp.get("customer", "allowed_prefixes", fallback="").replace(",", " ").split()
    prefixes = [p.lstrip("+") for p in prefixes]
    for p in prefixes:
        if not RE_PREFIX.match(p):
            raise Fail(f"{path}: allowed prefix '{p}' must be digits of an international number, e.g. 1 or 44 or 3556")
    exts = {}
    for section in cp.sections():
        if section == "customer":
            continue
        m = re.match(r"^ext\s+(\S+)$", section)
        if not m or not RE_EXT.match(m.group(1)):
            raise Fail(f"{path}: bad section [{section}], expected [ext <digits>]")
        ext = m.group(1)
        password = cp.get(section, "password", fallback="")
        cid = cp.get(section, "cid", fallback="").strip()
        if len(password) < 16:
            raise Fail(f"{path}: [{section}] password is missing or shorter than 16 characters")
        cid2 = cp.get(section, "cid2", fallback="").strip()
        for key, value in (("cid", cid), ("cid2", cid2)):
            if key == "cid2" and not value:
                continue
            if value.startswith("pool:"):
                if not RE_POOL.match(value[5:]):
                    raise Fail(f"{path}: [{section}] bad pool name in {key}")
            elif not RE_E164.match(value):
                raise Fail(f"{path}: [{section}] {key} must be +<number> or pool:<name>")
        exts[ext] = {"password": password, "cid": cid, "cid2": cid2}
    return {"name": name, "max_calls": max_calls, "max_seconds": max_seconds,
            "prefixes": sorted(set(prefixes)), "default_country": default_country, "exts": exts}


def list_customers():
    if not CUSTOMERS.exists():
        return []
    names = sorted(p.stem for p in CUSTOMERS.glob("*.conf"))
    for n in names:
        if not RE_CUSTOMER.match(n):
            raise Fail(f"{CUSTOMERS}/{n}.conf: bad customer file name")
    return names


def save_customer(cust):
    lines = [f"# Customer '{cust['name']}'. Edit, then run: voipctl apply",
             "[customer]",
             f"max_calls = {cust['max_calls']}",
             f"max_call_seconds = {cust['max_seconds']}",
             f"allowed_prefixes = {' '.join(cust['prefixes'])}"]
    if cust.get("default_country"):
        lines.append(f"default_country = {cust['default_country']}")
    lines.append("")
    for ext in sorted(cust["exts"]):
        e = cust["exts"][ext]
        lines += [f"[ext {ext}]", f"password = {e['password']}", f"cid = {e['cid']}"]
        if e.get("cid2"):
            lines.append(f"cid2 = {e['cid2']}")
        lines.append("")
    write_file(customer_path(cust["name"]), "\n".join(lines), mode=0o600)


def new_password(length=32):
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


# ---------------------------------------------------------------- CID pools
def load_pool(name):
    """Return the valid numbers in a pool file (comments/blank lines ignored)."""
    path = POOLS / f"{name}.txt"
    if not path.exists():
        raise Fail(f"no such caller ID pool: {name} (expected {path})")
    numbers, bad = [], []
    for raw in path.read_text().splitlines():
        value = raw.partition("#")[0].strip().replace(" ", "")
        if not value:
            continue
        (numbers if RE_E164.match(value) else bad).append(value)
    return numbers, bad


def list_pools():
    if not POOLS.exists():
        return []
    return sorted(p.stem for p in POOLS.glob("*.txt") if RE_POOL.match(p.stem))


def sync_pools(quiet=False):
    """Compile /etc/voip/cidpools/*.txt into the clean lists Asterisk reads."""
    gid = asterisk_gid()
    POOL_OUT.mkdir(parents=True, exist_ok=True)
    os.chmod(POOL_OUT, 0o750)
    os.chown(POOL_OUT, 0, gid)
    wanted = set()
    for name in list_pools():
        numbers, bad = load_pool(name)
        for b in bad:
            warn(f"pool {name}: ignoring invalid number '{b}' (use +<countrycode><number>)")
        if not numbers:
            warn(f"pool {name}: no valid numbers - calls using it will be rejected")
        target = POOL_OUT / f"{name}.list"
        wanted.add(target.name)
        write_file(target, "".join(n + "\n" for n in numbers), mode=0o640, gid=gid)
        if not quiet:
            print(f"pool {name}: {len(numbers)} number(s)")
    for stale in POOL_OUT.glob("*.list"):
        if stale.name not in wanted:
            stale.unlink()


# ---------------------------------------------------------------- blocked prefixes
def load_blocked():
    prefixes = []
    if BLOCKED.exists():
        for num, raw in enumerate(BLOCKED.read_text().splitlines(), 1):
            value = raw.partition("#")[0].strip().lstrip("+")
            if not value:
                continue
            if not RE_PREFIX.match(value):
                raise Fail(f"{BLOCKED}:{num}: '{value}' is not a digit prefix")
            prefixes.append(value)
    return sorted(set(prefixes))


# ---------------------------------------------------------------- rendering
def render_pjsip_telnyx(tel, creds):
    out = [f"; {GENERATED}", ""]
    if not creds:
        out += ["; Telnyx credentials are not set yet. Run: voipctl telnyx set-creds", ""]
        return "\n".join(out)
    user, password = creds
    out += [
        "[telnyx]",
        "type=endpoint",
        "transport=transport-udp",
        "context=from-telnyx",
        "disallow=all",
        "allow=ulaw,alaw",
        "outbound_auth=telnyx-auth",
        "aors=telnyx",
        f"from_domain={tel['host']}",
        "direct_media=no",
        "dtmf_mode=rfc4733",
        "allow_transfer=no",
        "allow_subscribe=no",
        "trust_id_inbound=no",
        "send_pai=no",
        "send_rpid=no",
        "",
        "[telnyx-auth]",
        "type=auth",
        "auth_type=userpass",
        f"username={ast_escape(user)}",
        f"password={ast_escape(password)}",
        "",
        "[telnyx]",
        "type=aor",
        f"contact=sip:{tel['host']}:{tel['port']}",
        "qualify_frequency=60",
        "",
        "; Requests arriving from Telnyx signalling addresses map to the trunk",
        "; endpoint, whose context only hangs up (this server is outbound-only).",
        "[telnyx-identify]",
        "type=identify",
        "endpoint=telnyx",
    ]
    out += [f"match={fmt_net(n)}" for n in tel["signaling"]]
    out.append("")
    return "\n".join(out)


def render_pjsip_customers(customers, whitelist):
    out = [f"; {GENERATED}", ""]
    for cust in customers:
        nets = nets_for(whitelist, "customer", cust["name"])
        out.append(f";;;;;;;; customer {cust['name']}: {len(cust['exts'])} extension(s), "
                   f"source lock: {len(nets) or 'none (Hetzner firewall only)'}")
        for ext in sorted(cust["exts"]):
            e = cust["exts"][ext]
            name = ext
            mode, value = ("pool", e["cid"][5:]) if e["cid"].startswith("pool:") else ("fixed", e["cid"])
            out += [
                f"[{name}]",
                "type=endpoint",
                "transport=transport-udp",
                f"context=cust-{cust['name']}",
                f"accountcode={cust['name']}",
                "disallow=all",
                "allow=ulaw,alaw",
                f"auth={name}",
                f"aors={name}",
                "identify_by=username,auth_username",
                "direct_media=no",
                "rtp_symmetric=yes",
                "force_rport=yes",
                "rewrite_contact=yes",
                "dtmf_mode=rfc4733",
                "allow_transfer=no",
                "allow_subscribe=no",
                "trust_id_inbound=no",
                "send_pai=no",
                "send_rpid=no",
                "ice_support=no",
                f"set_var=VOIP_EXT={ext}",
                f"set_var=VOIP_CID_MODE={mode}",
                f"set_var=VOIP_CID_VALUE={value}",
            ]
            if e.get("cid2"):
                m2, v2 = ("pool", e["cid2"][5:]) if e["cid2"].startswith("pool:") else ("fixed", e["cid2"])
                out += [f"set_var=VOIP_CID2_MODE={m2}", f"set_var=VOIP_CID2_VALUE={v2}"]
            if nets:
                out += ["; optional source lock: only these addresses may use the endpoint",
                        "deny=0.0.0.0/0.0.0.0"]
                out += [f"permit={n.network_address}/{n.netmask}" for n in nets]
            out += [
                "",
                f"[{name}]",
                "type=auth",
                "auth_type=userpass",
                f"username={name}",
                f"password={e['password']}",
                "",
                f"[{name}]",
                "type=aor",
                "max_contacts=1",
                "remove_existing=yes",
                "minimum_expiration=60",
                "default_expiration=300",
                "maximum_expiration=3600",
                "qualify_frequency=0",
                "",
            ]
    return "\n".join(out) + "\n"


def render_extensions(customers, blocked):
    out = [f"; {GENERATED}", ""]
    out += ["; Prefixes nobody may call, whatever their allowed list says.", "[voip-blocked]"]
    out += [f"exten => _+{p}.,1,NoOp(blocked prefix)" for p in blocked]
    out.append("")
    for cust in customers:
        n = cust["name"]
        out += [f"; Destinations customer '{n}' may call.", f"[dest-{n}]"]
        out += [f"exten => _+{p}.,1,NoOp(allowed prefix)" for p in cust["prefixes"]]
        out += [
            "",
            f"[cust-{n}]",
            f"exten => _[+0-9].,1,NoOp({n}/${{VOIP_EXT}} from ${{CHANNEL(pjsip,remote_addr)}} dialed ${{EXTEN}})",
            " same => n,Set(CDR(customer_ext)=${VOIP_EXT})",
            " same => n,Set(CDR(src_ip)=${CHANNEL(pjsip,remote_addr)})",
            "; --- normalise to +E.164; anything that is not purely + and digits is refused",
            " same => n,Set(RAW=${FILTER(+0-9,${EXTEN})})",
            ' same => n,GotoIf($["${RAW}" != "${EXTEN}"]?invalid)',
            " same => n,Set(NUM=${RAW})",
            ' same => n,ExecIf($["${RAW:0:1}" = "+"]?Set(NUM=${RAW:1}))',
            ' same => n,ExecIf($["${RAW:0:2}" = "00"]?Set(NUM=${RAW:2}))',
        ] + ([
            "; national format: one leading 0 means the customer's default country",
            ' same => n,ExecIf($["${RAW:0:1}" = "0" & "${RAW:0:2}" != "00"]?Set(NUM=%s${RAW:1}))' % cust["default_country"],
        ] if cust["default_country"] else []) + [
            " same => n,Set(NUM=${FILTER(0-9,${NUM})})",
            ' same => n,GotoIf($[${LEN(${NUM})} < 7 | ${LEN(${NUM})} > 15 | "${NUM:0:1}" = "0"]?invalid)',
            " same => n,Set(DEST=+${NUM})",
            " same => n,Set(CDR(dialed)=${DEST})",
            "; --- destination policy",
            " same => n,GotoIf(${DIALPLAN_EXISTS(voip-blocked,${DEST},1)}?denied)",
            f" same => n,GotoIf(${{DIALPLAN_EXISTS(dest-{n},${{DEST}},1)}}?:denied)",
            "; --- concurrent call limit",
            f" same => n,Set(GROUP(cust)={n})",
            f" same => n,GotoIf($[${{GROUP_COUNT({n}@cust)}} > {cust['max_calls']}]?limit)",
            "; --- caller ID: fixed number, or a random line from the pool",
            ' same => n,GotoIf($["${VOIP_CID_MODE}" = "pool"]?pool)',
            " same => n,Set(CID=${FILTER(+0-9,${VOIP_CID_VALUE})})",
            " same => n,Goto(cidcheck)",
            f" same => n(pool),Set(POOLFILE={POOL_OUT}/${{VOIP_CID_VALUE}}.list)",
            " same => n,Set(POOLN=${FILE_COUNT_LINE(${POOLFILE})})",
            " same => n,GotoIf($[0${POOLN} < 1]?nocid)",
            " same => n,Set(CID=${FILTER(+0-9,${FILE(${POOLFILE},${RAND(0,$[${POOLN} - 1])},1,l)})})",
            " same => n(cidcheck),GotoIf($[${LEN(${CID})} < 8]?nocid)",
            " same => n,Set(CALLERID(name)=)",
            " same => n,Set(CALLERID(num)=${CID})",
            f" same => n,Set(TIMEOUT(absolute)={cust['max_seconds']})",
            f" same => n,Dial(PJSIP/${{DEST}}@telnyx,{DIAL_TIMEOUT})",
            "; the Dial attempt is already recorded; do not log the hangup step as a second call",
            " same => n,Set(CDR_PROP(disable)=1)",
            " same => n,Hangup()",
            " same => n(invalid),Set(CDR(userfield)=REJECTED:invalid-number)",
            " same => n,Hangup(28)",
            " same => n(denied),Set(CDR(userfield)=REJECTED:destination-not-allowed)",
            " same => n,Hangup(21)",
            " same => n(limit),Set(CDR(userfield)=REJECTED:concurrent-limit)",
            " same => n,Hangup(34)",
            " same => n(nocid),Set(CDR(userfield)=REJECTED:no-caller-id)",
            " same => n,Hangup(21)",
            "; --- caller ID choice by prefix: 10<number> = first, 11<number> = second.",
            "; No real international number starts with 10 or 11, so these cannot clash.",
            f"exten => _10[+0-9].,1,Goto(cust-{n},${{FILTER(+0-9,${{EXTEN:2}})}},1)",
            'exten => _11[+0-9].,1,GotoIf($["${VOIP_CID2_MODE}" = ""]?nocid2)',
            " same => n,Set(VOIP_CID_MODE=${VOIP_CID2_MODE})",
            " same => n,Set(VOIP_CID_VALUE=${VOIP_CID2_VALUE})",
            f" same => n,Goto(cust-{n},${{FILTER(+0-9,${{EXTEN:2}})}},1)",
            " same => n(nocid2),Set(CDR(userfield)=REJECTED:no-second-caller-id)",
            " same => n,Hangup(21)",
            "",
        ]
    return "\n".join(out) + "\n"


def render_nft():
    rtp = f"{RTP_START}-{RTP_END}"
    return "\n".join([
        "#!/usr/sbin/nft -f",
        f"# {GENERATED}",
        "#",
        "# Port filter only. WHO may connect is decided by the Hetzner Cloud Firewall,",
        "# which is the single IP whitelist. This layer guarantees that nothing except",
        "# SSH, SIP and RTP is ever reachable on this host, whatever else gets installed.",
        "",
        f"table inet {NFT_TABLE}",
        f"delete table inet {NFT_TABLE}",
        f"table inet {NFT_TABLE} {{",
        "    chain input {",
        "        type filter hook input priority filter; policy drop;",
        '        iif "lo" accept',
        "        meta nfproto ipv6 drop",
        "        ct state invalid drop",
        "        ct state established,related accept",
        f'        iifname "{WAN_IF}" ip saddr {DHCP_SERVER} udp sport 67 udp dport 68 accept comment "DHCP lease renewal"',
        f'        tcp dport {SSH_PORT} accept comment "SSH"',
        f'        udp dport {SIP_PORT} accept comment "SIP"',
        f'        udp dport {rtp} accept comment "RTP"',
        '        counter comment "dropped by default policy"',
        "    }",
        "",
        "    chain forward {",
        "        type filter hook forward priority filter; policy drop;",
        "    }",
        "",
        "    chain output {",
        "        type filter hook output priority filter; policy accept;",
        "        meta nfproto ipv6 drop",
        "    }",
        "}",
        "",
    ])


def render_f2b(whitelist, tel):
    ignore = ["127.0.0.1/8"] + [fmt_net(n) for n in nets_for(whitelist, "admin")]
    ignore += [fmt_net(n) for n in tel["signaling"]]
    return "\n".join([
        f"# {GENERATED}",
        "[DEFAULT]",
        "# Admin and Telnyx addresses are never banned.",
        "ignoreip = " + " ".join(ignore),
        "# A ban drops every packet from the address, all protocols (SIP is UDP).",
        "banaction = nftables",
        "banaction_allports = nftables",
        "",
        "[sshd]",
        "enabled  = true",
        "action   = nftables[type=custom, blocktype=drop]",
        "maxretry = 3",
        "findtime = 10m",
        "bantime  = 1h",
        "",
        "[asterisk]",
        "enabled  = true",
        "backend  = auto",
        "logpath  = /var/log/asterisk/security",
        "action   = nftables[type=custom, blocktype=drop]",
        "maxretry = 8",
        "findtime = 10m",
        "bantime  = 1h",
        "",
        "# Repeat offenders get a week.",
        "[recidive]",
        "enabled  = true",
        "backend  = auto",
        "logpath  = /var/log/fail2ban.log",
        "action   = nftables[type=custom, blocktype=drop]",
        "maxretry = 3",
        "findtime = 1d",
        "bantime  = 1w",
        "",
    ])


# ---------------------------------------------------------------- apply
def build():
    whitelist = load_whitelist()
    tel = load_telnyx_ranges()
    blocked = load_blocked()
    customers = [load_customer(n) for n in list_customers()]
    names = {c["name"] for c in customers}
    pools = set(list_pools())
    for e in whitelist:
        if e["role"] == "customer" and e["customer"] not in names:
            raise Fail(f"{WHITELIST}: '{fmt_net(e['net'])}' is assigned to customer "
                       f"'{e['customer']}', which does not exist")
    owner = {}
    for c in customers:
        for ext in c["exts"]:
            if ext in owner:
                raise Fail(f"extension {ext} exists in both '{owner[ext]}' and '{c['name']}': "
                           "extension numbers are the SIP usernames and must be unique")
            owner[ext] = c["name"]
    for c in customers:
        if not c["prefixes"]:
            warn(f"customer {c['name']} has no allowed prefixes: every call will be rejected")
        for ext, e in c["exts"].items():
            for value in (e["cid"], e.get("cid2", "")):
                if value.startswith("pool:") and value[5:] not in pools:
                    raise Fail(f"customer {c['name']} ext {ext}: caller ID pool '{value[5:]}' does not exist")
    return {
        "whitelist": whitelist, "tel": tel, "customers": customers,
        "files": {
            OUT_PJSIP_TELNYX: render_pjsip_telnyx(tel, load_telnyx_creds()),
            OUT_PJSIP_CUST: render_pjsip_customers(customers, whitelist),
            OUT_EXT: render_extensions(customers, blocked),
            OUT_NFT: render_nft(),
            OUT_F2B: render_f2b(whitelist, tel),
        },
    }


def service_active(name):
    return run(["systemctl", "is-active", "--quiet", name], check=False, capture=False).returncode == 0


def cmd_apply(args):
    state = build()
    files = state["files"]

    with tempfile.NamedTemporaryFile("w", suffix=".nft", delete=False) as tmp:
        tmp.write(files[OUT_NFT])
    try:
        run(["nft", "-c", "-f", tmp.name])
    finally:
        os.unlink(tmp.name)

    if args.check:
        print("configuration is valid; nothing was changed (--check)")
        return

    gid = asterisk_gid()
    changed = {
        "telnyx": write_file(OUT_PJSIP_TELNYX, files[OUT_PJSIP_TELNYX], 0o640, gid),
        "pjsip": write_file(OUT_PJSIP_CUST, files[OUT_PJSIP_CUST], 0o640, gid),
        "dialplan": write_file(OUT_EXT, files[OUT_EXT], 0o640, gid),
        "nft": write_file(OUT_NFT, files[OUT_NFT], 0o700),
        "f2b": write_file(OUT_F2B, files[OUT_F2B], 0o644),
    }
    sync_pools(quiet=True)

    if args.no_firewall:
        print("firewall: rules written to /etc/nftables.conf but NOT loaded (--no-firewall)")
    else:
        run(["nft", "-f", str(OUT_NFT)])
        run(["systemctl", "enable", "--quiet", "nftables"], check=False)
        print("firewall: loaded (ports only; IP whitelist is the Hetzner firewall)")

    if service_active("asterisk"):
        run(["asterisk", "-rx", "core reload"])
        print("asterisk: reloaded")
    else:
        print("asterisk: not running, configuration written only")

    if changed["f2b"] and service_active("fail2ban"):
        run(["systemctl", "restart", "fail2ban"], check=False)
        print("fail2ban: restarted")

    exts = sum(len(c["exts"]) for c in state["customers"])
    print(f"applied: {len(state['customers'])} customer(s), {exts} extension(s)")


def apply_now():
    cmd_apply(argparse.Namespace(check=False, no_firewall=False))


# ---------------------------------------------------------------- commands
def cmd_whitelist(args):
    if args.action == "list":
        entries = load_whitelist()
        for e in entries:
            role = "admin" if e["role"] == "admin" else f"customer:{e['customer']}"
            print(f"{fmt_net(e['net']):<20} {role:<28} {e['label']}")
        if not entries:
            print("(whitelist is empty)")
        return
    net = parse_net(args.ip)
    if args.action == "add":
        role, customer = parse_role(args.role)
        if role == "customer" and customer not in list_customers():
            raise Fail(f"customer '{customer}' does not exist; create it first: voipctl customer add {customer}")
        for e in load_whitelist():
            if e["net"] == net and e["role"] == role and e["customer"] == customer:
                raise Fail(f"{fmt_net(net)} is already whitelisted as {args.role}")
        label = " ".join(args.label).replace("#", "").strip()
        with open(WHITELIST, "a") as fh:
            fh.write(f"{fmt_net(net):<20} {args.role:<24} # {label}\n")
        print(f"added {fmt_net(net)} as {args.role}")
    else:
        kept, removed = [], 0
        for raw in WHITELIST.read_text().splitlines():
            fields = raw.partition("#")[0].split()
            match = False
            if len(fields) == 2:
                try:
                    match = parse_net(fields[0]) == net and (args.role is None or fields[1] == args.role)
                except Fail:
                    match = False
            if match:
                removed += 1
            else:
                kept.append(raw)
        if not removed:
            raise Fail(f"{fmt_net(net)} is not in the whitelist" + (f" as {args.role}" if args.role else ""))
        backup = WHITELIST.read_text()
        write_file(WHITELIST, "\n".join(kept) + "\n", mode=0o600)
        try:
            build()
            apply_now()
        except Fail:
            write_file(WHITELIST, backup, mode=0o600)
            raise
        print(f"removed {fmt_net(net)} ({removed} line(s))")
        return
    try:
        apply_now()
    except Fail:
        lines = WHITELIST.read_text().splitlines()[:-1]
        write_file(WHITELIST, "\n".join(lines) + "\n", mode=0o600)
        raise


def cmd_customer(args):
    if args.action == "list":
        whitelist = load_whitelist()
        for name in list_customers():
            c = load_customer(name)
            ips = len(nets_for(whitelist, "customer", name))
            print(f"{name:<20} exts={len(c['exts']):<3} max_calls={c['max_calls']:<4} "
                  f"max_seconds={c['max_seconds']:<6} ips={ips:<3} allowed=+{' +'.join(c['prefixes']) or '(none)'}")
        return
    name = args.name
    if not RE_CUSTOMER.match(name):
        raise Fail("customer name: 2-20 characters, lowercase letters and digits, starting with a letter")
    if args.action == "add":
        if customer_path(name).exists():
            raise Fail(f"customer {name} already exists")
        cust = {"name": name, "max_calls": args.max_calls, "max_seconds": args.max_seconds,
                "prefixes": [p.lstrip("+") for p in (args.allow or "").replace(",", " ").split()],
                "default_country": (args.default_country or "").lstrip("+"), "exts": {}}
        save_customer(cust)
        load_customer(name)
        apply_now()
        print(f"customer {name} created. Next: voipctl ext add {name} <ext> --cid +<number> "
              f"(and allow the customer's IP in the Hetzner firewall)")
    elif args.action == "set":
        cust = load_customer(name)
        if args.max_calls is not None:
            cust["max_calls"] = args.max_calls
        if args.max_seconds is not None:
            cust["max_seconds"] = args.max_seconds
        if args.allow is not None:
            cust["prefixes"] = [p.lstrip("+") for p in args.allow.replace(",", " ").split()]
        if args.default_country is not None:
            cust["default_country"] = args.default_country.lstrip("+")
        backup = customer_path(name).read_text()
        save_customer(cust)
        try:
            load_customer(name)
            apply_now()
        except Fail:
            write_file(customer_path(name), backup, mode=0o600)
            raise
    elif args.action == "show":
        c = load_customer(name)
        print(f"customer:          {name}  (accountcode in CDR: {name})")
        print(f"max calls:         {c['max_calls']}")
        print(f"max call seconds:  {c['max_seconds']}")
        print(f"allowed prefixes:  +{' +'.join(c['prefixes']) or '(none)'}")
        if c["default_country"]:
            print(f"national numbers:  a leading 0 means +{c['default_country']}")
        ips = nets_for(load_whitelist(), "customer", name)
        print(f"source lock:       {' '.join(fmt_net(n) for n in ips) or 'none (any IP the Hetzner firewall allows)'}")
        for ext in sorted(c["exts"]):
            print(f"  ext {ext:<8} sip user {ext:<10} caller ID {c['exts'][ext]['cid']}"
                  + (f"   | prefix 11 -> {c['exts'][ext]['cid2']}" if c['exts'][ext].get('cid2') else ""))
    elif args.action == "del":
        if not args.yes:
            raise Fail(f"this deletes customer {name}, its extensions and its whitelist entries. "
                       "Repeat with --yes to confirm.")
        load_customer(name)
        kept = [raw for raw in WHITELIST.read_text().splitlines()
                if raw.partition("#")[0].split()[1:2] != [f"customer:{name}"]]
        write_file(WHITELIST, "\n".join(kept) + "\n", mode=0o600)
        customer_path(name).unlink()
        apply_now()
        print(f"customer {name} deleted. Remove its IPs from the Hetzner firewall.")


def parse_cid2(args):
    if args.cid2 and args.pool2:
        raise Fail("use either --cid2 or --pool2, not both")
    if args.cid2:
        if not RE_E164.match(args.cid2):
            raise Fail("--cid2 must be a full international number, e.g. +14155550100")
        return args.cid2
    if args.pool2:
        if args.pool2 not in list_pools():
            raise Fail(f"caller ID pool '{args.pool2}' does not exist")
        return f"pool:{args.pool2}"
    return None


def parse_cid(args):
    if args.cid and args.pool:
        raise Fail("use either --cid or --pool, not both")
    if args.cid:
        if not RE_E164.match(args.cid):
            raise Fail("--cid must be a full international number, e.g. +14155550100")
        return args.cid
    if args.pool:
        if args.pool not in list_pools():
            raise Fail(f"caller ID pool '{args.pool}' does not exist; create it: voipctl pool add {args.pool} +<number>")
        return f"pool:{args.pool}"
    return None


def cmd_ext(args):
    cust = load_customer(args.customer)
    name = cust["name"]
    if args.action == "list":
        for ext in sorted(cust["exts"]):
            print(f"{ext:<12} caller ID {cust['exts'][ext]['cid']}")
        return
    if not RE_EXT.match(args.ext):
        raise Fail("extension must be 2-8 digits")
    backup = customer_path(name).read_text()
    if args.action == "add":
        for other in list_customers():
            if args.ext in load_customer(other)["exts"]:
                raise Fail(f"extension {args.ext} already exists (customer {other}); "
                           "extension numbers are the SIP usernames and must be unique")
        cid = parse_cid(args)
        if not cid:
            raise Fail("give the caller ID: --cid +<number> or --pool <name>")
        cust["exts"][args.ext] = {"password": new_password(), "cid": cid, "cid2": parse_cid2(args) or ""}
    elif args.action == "set":
        if args.ext not in cust["exts"]:
            raise Fail(f"no extension {args.ext} for {name}")
        cid, cid2 = parse_cid(args), parse_cid2(args)
        if not cid and not cid2 and not args.no_cid2:
            raise Fail("give a caller ID: --cid/--pool (first) and/or --cid2/--pool2 (second, dial 11<number>)")
        if cid:
            cust["exts"][args.ext]["cid"] = cid
        if cid2:
            cust["exts"][args.ext]["cid2"] = cid2
        if args.no_cid2:
            cust["exts"][args.ext]["cid2"] = ""
    elif args.action == "passwd":
        if args.ext not in cust["exts"]:
            raise Fail(f"no extension {args.ext} for {name}")
        cust["exts"][args.ext]["password"] = new_password()
    elif args.action == "del":
        if args.ext not in cust["exts"]:
            raise Fail(f"no extension {args.ext} for {name}")
        del cust["exts"][args.ext]
    elif args.action == "show":
        if args.ext not in cust["exts"]:
            raise Fail(f"no extension {args.ext} for {name}")
        e = cust["exts"][args.ext]
        tel = load_telnyx_ranges()
        print(f"SIP server:    this server's public IP, UDP port {SIP_PORT}")
        print(f"SIP username:  {args.ext}")
        print(f"SIP password:  {e['password']}")
        print(f"caller ID:     {e['cid']}")
        if e.get("cid2"):
            print(f"2nd caller ID: {e['cid2']}   (dial 11 before the number; 10 = first caller ID)")
        print(f"codecs:        G.711 u-law / a-law        trunk: {tel['host']}")
        print("dial format:   +<country><number>, 00<country><number> or <country><number>")
        return
    save_customer(cust)
